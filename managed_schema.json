{
  "type": "object",
  "properties": {
    "locked": {
      "title": "Lock settings",
      "description": "When true, users cannot change Privacy Guard settings in the options page.",
      "type": "boolean"
    },
    "enabled": { "title": "Protection enabled", "type": "boolean" },
    "reviewAll": { "title": "Review every prompt", "type": "boolean" },
    "strictMode": { "title": "Strict mode", "type": "boolean" },
    "scanPaste": { "title": "Scan pasted text", "type": "boolean" },
    "scanFiles": { "title": "Scan uploaded files", "type": "boolean" },
    "showBadge": { "title": "Show on-page badge", "type": "boolean" },
    "policy": {
      "title": "Action per severity (block, review, note, off)",
      "type": "object",
      "properties": {
        "critical": { "type": "string", "enum": ["block", "review", "note", "off"] },
        "high": { "type": "string", "enum": ["block", "review", "note", "off"] },
        "medium": { "type": "string", "enum": ["block", "review", "note", "off"] },
        "low": { "type": "string", "enum": ["block", "review", "note", "off"] }
      }
    },
    "categories": {
      "title": "Enabled detection categories",
      "type": "object",
      "properties": {
        "pii": { "type": "boolean" },
        "credential": { "type": "boolean" },
        "cloud_secret": { "type": "boolean" },
        "env": { "type": "boolean" },
        "config": { "type": "boolean" },
        "log": { "type": "boolean" },
        "network": { "type": "boolean" },
        "custom": { "type": "boolean" },
        "ai": { "type": "boolean" }
      }
    },
    "packs": {
      "title": "Country identifier packs",
      "type": "object",
      "properties": {
        "pk": { "type": "boolean" },
        "us": { "type": "boolean" },
        "uk": { "type": "boolean" },
        "in": { "type": "boolean" },
        "ae": { "type": "boolean" }
      }
    },
    "customRules": {
      "title": "Custom regex rules",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "pattern": { "type": "string" },
          "flags": { "type": "string" }
        }
      }
    },
    "dictionary": { "title": "Confidential terms", "type": "array", "items": { "type": "string" } },
    "internalDomains": { "title": "Internal domains", "type": "array", "items": { "type": "string" } },
    "allowlist": { "title": "Values never flagged", "type": "array", "items": { "type": "string" } },
    "disabledSites": { "title": "Hostnames where protection is off", "type": "array", "items": { "type": "string" } }
  }
}
