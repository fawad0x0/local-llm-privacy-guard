{
  "name": "local-llm-privacy-guard",
  "version": "0.2.0",
  "private": true,
  "description": "Browser extension that scans prompts, pastes and uploads locally for secrets and personal data before they reach AI chats.",
  "license": "MIT",
  "author": "fawad0x0 (https://github.com/fawad0x0)",
  "homepage": "https://github.com/fawad0x0/local-llm-privacy-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fawad0x0/local-llm-privacy-guard.git"
  },
  "bugs": {
    "url": "https://github.com/fawad0x0/local-llm-privacy-guard/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "privacy",
    "secrets-detection",
    "pii",
    "dlp",
    "llm",
    "chatgpt",
    "ollama"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.e2e.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,html,md}\"",
    "lint:firefox": "node scripts/build.js && web-ext lint --source-dir dist/extension",
    "icons": "node scripts/make-icons.js",
    "build": "node scripts/build.js",
    "zip": "node scripts/build.js && web-ext build --source-dir dist/extension --artifacts-dir dist --overwrite-dest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "web-ext": "^10.7.0"
  }
}
